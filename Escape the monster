<!DOCTYPE html>

<html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0"> <title>Escape the Monster</title> <style> body { background: #101018; color: white; font-family: Arial, sans-serif; text-align: center; margin: 0; padding: 20px; } h1 { color: #ff3333; } #stats { display: flex; justify-content: center; gap: 25px; margin: 15px; } #game { display: grid; grid-template-columns: repeat(9, 1fr); gap: 3px; max-width: 420px; margin: 20px auto; } .tile { aspect-ratio: 1; background: #30303c; display: flex; align-items: center; justify-content: center; border-radius: 5px; font-size: clamp(16px, 5vw, 27px); } .wall { background: #666; } button { background: #b52222; color: white; border: none; border-radius: 10px; padding: 14px 20px; font-size: 20px; margin: 4px; cursor: pointer; } button:active { background: #ff4444; } #message { color: #ffcc55; min-height: 30px; font-size: 18px; } #controls { margin: 15px; } </style> </head> <body>

<h1>👹 ESCAPE THE MONSTER</h1> <p>Find the key and escape before the monster catches you!</p>

<div id="stats"> <span>❤️ <b id="lives">3</b></span> <span>👣 <b id="moves">0</b></span> <span>🔑 <b id="key">NO</b></span> </div>

<div id="game"></div>

<p id="message">Find the key! The monster is hunting you...</p>

<div id="controls"> <div><button onclick="move('up')">⬆️</button></div> <div> <button onclick="move('left')">⬅️</button> <button onclick="move('down')">⬇️</button> <button onclick="move('right')">➡️</button> </div> </div>

<button onclick="restart()">🔄 Restart</button>

<script> const map = [ "#########", "#.......#", "#.##....#", "#.......#", "#...##..#", "#.......#", "#.##....#", "#.......#", "#########" ]; let player, monster, key, exit; let lives, moves, hasKey, gameOver; function restart() { player = {x:1, y:1}; monster = {x:7, y:7}; key = {x:7, y:1}; exit = {x:1, y:7}; lives = 3; moves = 0; hasKey = false; gameOver = false; document.getElementById("message").textContent = "Find the key! The monster is hunting you!"; render(); } function wall(x,y) { return map[y]?.[x] !== "."; } function render() { const game = document.getElementById("game"); game.innerHTML = ""; for(let y=0;y<9;y++) { for(let x=0;x<9;x++) { const tile = document.createElement("div"); tile.className = "tile" + (wall(x,y) ? " wall" : ""); if(player.x===x && player.y===y) tile.textContent="🧍"; else if(monster.x===x && monster.y===y) tile.textContent="👹"; else if(key.x===x && key.y===y && !hasKey) tile.textContent="🔑"; else if(exit.x===x && exit.y===y) tile.textContent="🚪"; else if(wall(x,y)) tile.textContent="🧱"; game.appendChild(tile); } } document.getElementById("lives").textContent = lives; document.getElementById("moves").textContent = moves; document.getElementById("key").textContent = hasKey ? "YES" : "NO"; } function finish(win) { gameOver = true; document.getElementById("message").textContent = win ? "🎉 YOU ESCAPED! YOU WIN!" : "💀 THE MONSTER CAUGHT YOU! GAME OVER!"; render(); } function move(direction) { if(gameOver) return; let dx=0, dy=0; if(direction==="up") dy=-1; if(direction==="down") dy=1; if(direction==="left") dx=-1; if(direction==="right") dx=1; let nx=player.x+dx; let ny=player.y+dy; if(wall(nx,ny)) return; player={x:nx,y:ny}; moves++; if(player.x===key.x && player.y===key.y && !hasKey) { hasKey=true; document.getElementById("message").textContent="🔑 You found the key! Escape!"; } if(player.x===exit.x && player.y===exit.y && hasKey) { finish(true); return; } if(player.x===monster.x && player.y===monster.y) { loseLife(); return; } monsterMove(); if(player.x===monster.x && player.y===monster.y) { loseLife(); return; } if(!gameOver) { let distance=Math.abs(player.x-monster.x)+Math.abs(player.y-monster.y); if(distance<=2) { document.getElementById("message").textContent="🚨 RUN! THE MONSTER IS CLOSE!"; } else if(hasKey) { document.getElementById("message").textContent="Get to the exit! 🚪"; } else { document.getElementById("message").textContent="Find the key! 🔑"; } } render(); } function loseLife() { lives--; if(lives<=0) { finish(false); return; } player={x:1,y:1}; document.getElementById("message").textContent="😱 The monster caught you! You lost a life!"; render(); } function monsterMove() { let options = [ {x:monster.x+1,y:monster.y}, {x:monster.x-1,y:monster.y}, {x:monster.x,y:monster.y+1}, {x:monster.x,y:monster.y-1} ].filter(p=>!wall(p.x,p.y)); options.sort((a,b)=>{ let da=Math.abs(a.x-player.x)+Math.abs(a.y-player.y); let db=Math.abs(b.x-player.x)+Math.abs(b.y-player.y); return da-db; }); if(options.length) { let distance=Math.abs(player.x-monster.x)+Math.abs(player.y-monster.y); monster = distance<=5 ? options[0] : options[Math.floor(Math.random()*options.length)]; } } document.addEventListener("keydown", e=>{ const keys={ ArrowUp:"up", ArrowDown:"down", ArrowLeft:"left", ArrowRight:"right" }; if(keys[e.key]) { e.preventDefault(); move(keys[e.key]); } }); restart(); </script>

</body> </html>
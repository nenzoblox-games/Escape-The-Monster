<!DOCTYPE html>

<html lang="en"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"> <title>ESCAPE THE MONSTER 3D</title> <style> *{box-sizing:border-box} body{margin:0;overflow:hidden;background:#050609;color:white;font-family:Arial} #ui{position:absolute;inset:0;pointer-events:none} #top{padding:15px;display:flex;justify-content:space-between;font-weight:bold;text-shadow:0 2px 5px black} #message{position:absolute;top:18%;width:100%;text-align:center;color:#ff5555;font-size:20px;text-shadow:0 2px 5px black} #controls{position:absolute;bottom:20px;width:100%;display:flex;justify-content:space-between;padding:15px;align-items:end} #pad{display:grid;grid-template-columns:55px 55px 55px;gap:5px;pointer-events:auto} button{background:#222b;color:white;border:2px solid #777;border-radius:12px;font-size:22px;width:55px;height:55px;touch-action:none} #actions{display:flex;flex-direction:column;gap:8px;pointer-events:auto} #actions button{width:75px;height:55px;font-size:14px;background:#741c1c} #start{position:absolute;inset:0;background:#050609;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:25px;pointer-events:auto} #start button{width:200px;height:55px;background:#a11;font-size:20px} #cross{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);font-size:22px;color:#ffffff99} </style> </head> <body> <div id="ui"> <div id="top"> <span>❤️ <span id="health">100</span></span> <span>🔑 <span id="key">NO</span></span> <span>👹 <span id="danger">SAFE</span></span> </div> <div id="message">FIND THE KEY AND ESCAPE!</div> <div id="cross">+</div> <div id="controls"> <div id="pad"> <span></span><button data-move="forward">⬆</button><span></span> <button data-move="left">⬅</button><button data-move="back">⬇</button><button data-move="right">➡</button> </div> <div id="actions"> <button id="run">🏃 RUN</button> <button id="light">🔦 LIGHT</button> </div> </div> </div> <div id="start"> <h1 style="color:#f33;font-size:35px">ESCAPE THE MONSTER</h1> <h2>3D HORROR SURVIVAL</h2> <p>Find the key. Avoid the monster. Escape alive.</p> <p>Use the arrows to move. Drag on the screen to look around.</p> <button id="play">PLAY NOW</button> </div>

<script type="module"> import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js'; const scene=new THREE.Scene(); scene.background=new THREE.Color(0x050608); scene.fog=new THREE.FogExp2(0x050608,.045); const camera=new THREE.PerspectiveCamera(75,innerWidth/innerHeight,.1,100); camera.rotation.order='YXZ'; const renderer=new THREE.WebGLRenderer({antialias:true}); renderer.setSize(innerWidth,innerHeight); renderer.setPixelRatio(Math.min(devicePixelRatio,2)); renderer.shadowMap.enabled=true; renderer.shadowMap.type=THREE.PCFSoftShadowMap; document.body.appendChild(renderer.domElement); scene.add(new THREE.HemisphereLight(0x647080,0x151019,.35)); const lamp=new THREE.PointLight(0xffd9a0,1.8,12); camera.add(lamp); scene.add(camera); const flashlight=new THREE.SpotLight(0xffffff,35,22,.35,.5,1); camera.add(flashlight); flashlight.position.set(0,0,0); flashlight.target.position.set(0,0,-1); camera.add(flashlight.target); const mat=(color)=>new THREE.MeshStandardMaterial({color,roughness:.9}); const floor=new THREE.Mesh(new THREE.PlaneGeometry(40,40),mat(0x25242a)); floor.rotation.x=-Math.PI/2; floor.position.y=0; floor.receiveShadow=true; scene.add(floor); const wallMat=mat(0x41404a); function box(x,y,z,sx,sy,sz,material=wallMat){ const o=new THREE.Mesh(new THREE.BoxGeometry(sx,sy,sz),material); o.position.set(x,y,z); o.castShadow=true; o.receiveShadow=true; scene.add(o); return o; } // Build an abandoned maze const walls=[]; function wall(x,z,sx,sz){ box(x,1.5,z,sx,3,sz); walls.push({x,z,sx,sz}); } wall(0,-8,20,1); wall(0,8,20,1); wall(-10,0,1,16); wall(10,0,1,16); wall(-5,-5,1,5); wall(-2,-2,5,1); wall(4,-5,1,5); wall(5,1,5,1); wall(-5,4,1,5); wall(0,5,5,1); wall(7,5,1,5); wall(-7,0,4,1); wall(2,3,1,3); wall(0,-5,3,1); // Ceiling lights for(let x=-6;x<=6;x+=4){ const l=new THREE.PointLight(0xffbb88,.6,7); l.position.set(x,2.7,-2); scene.add(l); box(x,2.95,-2,.7,.08,.7,mat(0xaaa08a)); } // Player const player={x:0,z:6,angle:0}; camera.position.set(player.x,1.6,player.z); // Monster const monster=new THREE.Group(); const dark=mat(0x090909); const red=new THREE.MeshBasicMaterial({color:0xff0000}); const body=new THREE.Mesh(new THREE.BoxGeometry(.8,1.4,.55),dark); body.position.y=1; monster.add(body); const head=new THREE.Mesh(new THREE.SphereGeometry(.4,12,12),dark); head.position.y=2; monster.add(head); for(let x of [-.15,.15]){ const eye=new THREE.Mesh(new THREE.SphereGeometry(.07,8,8),red); eye.position.set(x,2.05,-.35); monster.add(eye); } monster.position.set(7,0,-6); scene.add(monster); // Key const keyObject=new THREE.Group(); const gold=mat(0xffd000); const ring=new THREE.Mesh(new THREE.TorusGeometry(.2,.055,8,16),gold); keyObject.add(ring); const stem=box(0,0,0,.08,.5,.08,gold); stem.position.y=-.28; keyObject.position.set(-7,.8,-6); scene.add(keyObject); // Exit door const door=box(0,1,-7.5,1.7,2.3,.2,mat(0x197c35)); door.position.x=8; const handle=box(8.5,1,.0,.12,.12,.12,gold); handle.position.set(8.5,1,-7.36); let hasKey=false,health=100,active=false,gameOver=false,lightOn=true; let yaw=0,pitch=0; const held={forward:false,back:false,left:false,right:false}; let running=false; function blocked(x,z){ for(const w of walls){ if(Math.abs(x-w.x)<w.sx/2+.4&&Math.abs(z-w.z)<w.sz/2+.4)return true; } return Math.abs(x)>9||Math.abs(z)>7; } function updateUI(){ document.getElementById('health').textContent=health; document.getElementById('key').textContent=hasKey?'YES':'NO'; const d=Math.hypot(player.x-monster.position.x,player.z-monster.position.z); document.getElementById('danger').textContent=d<3?'DANGER!':d<6?'NEAR':'SAFE'; } function end(win){ gameOver=true; active=false; document.getElementById('message').textContent=win?'🎉 YOU ESCAPED!':'💀 THE MONSTER CAUGHT YOU!'; document.getElementById('start').style.display='flex'; document.querySelector('#start h1').textContent=win?'YOU SURVIVED!':'GAME OVER'; document.querySelector('#start h2').textContent=win?'Congratulations!':'The monster got you!'; document.getElementById('play').textContent='PLAY AGAIN'; } function start(){ player.x=0;player.z=6;yaw=0;pitch=0; camera.position.set(0,1.6,6); monster.position.set(7,0,-6); keyObject.visible=true; hasKey=false;health=100;gameOver=false;active=true; document.getElementById('start').style.display='none'; document.getElementById('message').textContent='Find the golden key!'; updateUI(); } document.getElementById('play').onclick=start; document.querySelectorAll('[data-move]').forEach(b=>{ const d=b.dataset.move; b.addEventListener('pointerdown',e=>{e.preventDefault();held[d]=true}); for(const event of ['pointerup','pointercancel','pointerleave']) b.addEventListener(event,()=>held[d]=false); }); document.getElementById('run').addEventListener('pointerdown',()=>running=true); ['pointerup','pointercancel','pointerleave'].forEach(e=>document.getElementById('run').addEventListener(e,()=>running=false)); document.getElementById('light').onclick=()=>{ lightOn=!lightOn; flashlight.visible=lightOn; lamp.visible=lightOn; }; let dragging=false,lastX=0,lastY=0; renderer.domElement.addEventListener('pointerdown',e=>{ if(e.pointerType==='mouse'||e.pointerType==='touch'){ dragging=true;lastX=e.clientX;lastY=e.clientY; } }); window.addEventListener('pointerup',()=>dragging=false); window.addEventListener('pointermove',e=>{ if(!dragging||!active)return; yaw-=(e.clientX-lastX)*.005; pitch=Math.max(-1.1,Math.min(1.1,pitch-(e.clientY-lastY)*.004)); lastX=e.clientX;lastY=e.clientY; }); function tick(){ requestAnimationFrame(tick); if(active){ const speed=running?.105:.055; const forward=(held.forward?1:0)-(held.back?1:0); const side=(held.right?1:0)-(held.left?1:0); const dx=(Math.sin(yaw)*forward+Math.cos(yaw)*side)*speed; const dz=(-Math.cos(yaw)*forward+Math.sin(yaw)*side)*speed; if(!blocked(player.x+dx,player.z))player.x+=dx; if(!blocked(player.x,player.z+dz))player.z+=dz; camera.position.set(player.x,1.6,player.z); camera.rotation.set(pitch,yaw,0); // Monster chases player const mx=player.x-monster.position.x; const mz=player.z-monster.position.z; const distance=Math.hypot(mx,mz); if(distance>.85){ const step=.025; const nx=monster.position.x+mx/distance*step; const nz=monster.position.z+mz/distance*step; if(!blocked(nx,monster.position.z))monster.position.x=nx; if(!blocked(monster.position.x,nz))monster.position.z=nz; }else{ health-=.25; if(health<=0)end(false); } monster.lookAt(player.x,1,player.z); if(player.x-keyObject.position.x<.8&&player.x-keyObject.position.x>-.8&&player.z-keyObject.position.z<.8&&player.z-keyObject.position.z>-.8&&!hasKey){ hasKey=true;keyObject.visible=false; document.getElementById('message').textContent='🔑 KEY FOUND! GO TO THE GREEN EXIT!'; } if(hasKey&&Math.hypot(player.x-8,player.z+7)<1.3)end(true); updateUI(); } keyObject.rotation.y+=.025; keyObject.position.y=.8+Math.sin(Date.now()*.003)*.12; renderer.render(scene,camera); } tick(); addEventListener('resize',()=>{ camera.aspect=innerWidth/innerHeight; camera.updateProjectionMatrix(); renderer.setSize(innerWidth,innerHeight); }); </script>

</body> </html>
